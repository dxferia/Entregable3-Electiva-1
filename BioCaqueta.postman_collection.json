{
  "info": {
    "name": "BioCaquetá API",
    "description": "Pruebas del taller BioCaquetá. Ejecutar en orden (el POST guarda el _id en la variable {{id}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Consultar todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/avistamientos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "avistamientos"
          ]
        },
        "description": "Lista todos los avistamientos, del más reciente al más antiguo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"data es un arreglo\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Filtrar por categoría (Ave)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/avistamientos?categoria=Ave",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "avistamientos"
          ],
          "query": [
            {
              "key": "categoria",
              "value": "Ave"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Solo categoría Ave\", () => pm.response.json().data.forEach(a => pm.expect(a.categoria).to.eql(\"Ave\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Registrar avistamiento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/avistamientos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "avistamientos"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreComun\": \"Guacamaya bandera\",\n  \"nombreCientifico\": \"Ara macao\",\n  \"categoria\": \"Ave\",\n  \"zona\": \"Río Hacha\",\n  \"investigador\": \"Nombre del estudiante\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
              "const a = pm.response.json();",
              "pm.collectionVariables.set(\"id\", a._id);",
              "pm.test(\"Estado por defecto\", () => pm.expect(a.estadoConservacion).to.eql(\"Preocupación menor\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Actualizar zona y estado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/avistamientos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "avistamientos",
            "{{id}}"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zona\": \"El Caraño\",\n  \"estadoConservacion\": \"Vulnerable\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Zona actualizada\", () => pm.expect(pm.response.json().data.zona).to.eql(\"El Caraño\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Eliminar avistamiento",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/avistamientos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "avistamientos",
            "{{id}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Errores y validaciones",
      "item": [
        {
          "name": "Falta campo obligatorio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/avistamientos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "avistamientos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreComun\": \"Danta amazónica\",\n  \"categoria\": \"Mamífero\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Categoría no permitida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/avistamientos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "avistamientos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreComun\": \"Bagre\",\n  \"nombreCientifico\": \"Brachyplatystoma\",\n  \"categoria\": \"Pez\",\n  \"zona\": \"Río Caquetá\",\n  \"investigador\": \"Nombre del estudiante\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estado de conservación inválido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/avistamientos/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "avistamientos",
                "{{id}}"
              ]
            },
            "description": "Ejecútala antes del paso 5 para obtener 400; después de eliminar el registro devuelve 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estadoConservacion\": \"Extinto\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 si el registro existe, 404 si ya se eliminó\", () => pm.expect(pm.response.code).to.be.oneOf([400, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Id con formato incorrecto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/avistamientos/123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "avistamientos",
                "123"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zona\": \"El Caraño\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Id inexistente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/avistamientos/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "avistamientos",
                "000000000000000000000000"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}