<style>
    .hero { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 2rem; min-height: calc(100svh - 92px); padding-block: 2rem 4rem; }
    .hero .trogon { justify-self: end; width: min(100%, 440px); aspect-ratio: 640 / 896; }
    .datos { display: flex; flex-wrap: wrap; gap: 2.5rem; margin-top: 2.6rem; }
    .datos p { margin: 0; }
    .datos strong { display: block; font-size: 2rem; font-weight: 800; color: #fff; line-height: 1; }
    .datos span { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--suave); }

    .registro { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; align-items: center; padding-block: 5rem; }
    .registro .monos { width: 100%; aspect-ratio: 900 / 692; }
    .registro form { margin-top: 2rem; }
    .registro button { grid-column: 1 / -1; justify-self: start; }

    .listado { padding-block: 4rem 5rem; }
    .listado-encabezado { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; }
    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    th { padding: .8rem .6rem; text-align: left; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brillante); border-bottom: 1.5px solid rgba(74, 222, 128, .45); }
    td { padding: 1rem .6rem; border-bottom: 1px solid var(--linea); vertical-align: middle; }
    tbody tr { transition: background .2s; }
    tbody tr:hover { background: rgba(255, 255, 255, .04); }
    td.especie strong { display: block; color: #fff; font-weight: 600; }
    td.especie em { color: var(--suave); font-size: .85rem; }
    td[data-estado]::before { content: ""; display: inline-block; width: .55rem; height: .55rem; margin-right: .5rem; border-radius: 50%; background: var(--brillante); }
    td[data-estado="Vulnerable"]::before { background: #facc15; }
    td[data-estado="En peligro"]::before { background: #f87171; }
    td.acciones-fila { white-space: nowrap; text-align: right; }
    td.acciones-fila form { display: inline; }
    td.acciones-fila .boton { min-height: 38px; padding: .4rem 1.1rem; font-size: .75rem; box-shadow: none; }
    td.acciones-fila button { min-height: 38px; font-size: .75rem; }
    .vacio { padding: 2rem 0; color: var(--suave); }

    @media (max-width: 1000px) {
        .registro { grid-template-columns: 1fr; gap: 0; padding-block: 3rem; }
        .registro .monos { width: min(100%, 420px); justify-self: center; }
    }
    @media (max-width: 820px) {
        .hero { grid-template-columns: 1fr; min-height: auto; padding-block: 1.5rem 2.5rem; gap: 0; }
        .hero .trogon { justify-self: center; width: min(85%, 340px); margin-top: 1.5rem; }
        .datos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
        .datos strong { font-size: 1.6rem; }
        .datos span { font-size: .68rem; }
        /* La tabla se convierte en filas apiladas, sin tarjetas */
        thead { display: none; }
        tr { display: grid; grid-template-columns: 1fr 1fr; gap: .2rem 1rem; padding: 1.2rem 0; border-bottom: 1px solid var(--linea); }
        td { padding: .25rem 0; border: 0; }
        td::before { content: attr(data-label); display: block; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--brillante); }
        td[data-estado]::before { content: attr(data-label); display: block; width: auto; height: auto; margin: 0; border-radius: 0; background: none; }
        td.especie, td.acciones-fila { grid-column: 1 / -1; }
        td.especie::before, td.acciones-fila::before { display: none; }
        td.acciones-fila { text-align: left; padding-top: .6rem; }
    }
</style>

<section class="hero contenedor" id="inicio">
    <div>
        <p class="etiqueta">Piedemonte Amazónico · Caquetá</p>
        <h1>BioCaquetá</h1>
        <p class="subtitulo">Biodiversidad en tiempo real</p>
        <p class="descripcion">Sistema de Monitoreo de Biodiversidad y Avistamientos del Piedemonte Amazónico. Reemplaza las libretas de campo:
            registra, consulta, actualiza y elimina avistamientos de fauna y flora en El Caraño, el río Hacha y la cordillera Oriental.</p>

        {{#if error}}
            <p class="error" role="alert">{{error}}</p>
        {{/if}}

        <div class="acciones">
            <a class="boton" href="#registrar">Registrar avistamiento</a>
            <a class="boton boton-linea" href="#avistamientos">Ver avistamientos</a>
        </div>

        <div class="datos">
            <p><strong>{{avistamientos.length}}</strong><span>Avistamientos</span></p>
            <p><strong>{{categorias.length}}</strong><span>Categorías</span></p>
            <p><strong>{{estadosConservacion.length}}</strong><span>Estados de conservación</span></p>
        </div>
    </div>
    <img class="fauna trogon" src="/img/trogon-enmascarado.jpg" alt="Trogón enmascarado (Trogon personatus) posado en una rama con musgo">
</section>

<div class="velo">
<section class="registro contenedor" id="registrar">
    <img class="fauna monos" src="/img/monos-ardilla.jpg" alt="Madre y cría de mono ardilla o chichico (Saimiri cassiquiarensis)">
    <div>
        <p class="etiqueta">Nuevo registro</p>
        <h2>Registrar avistamiento</h2>
        <p class="muted">Los campos marcados son obligatorios. El estado de conservación por defecto es “Preocupación menor”.</p>

        <form class="campos" action="/api/avistamientos" method="POST">
            <label>Nombre común *
                <input name="nombreComun" placeholder="Danta amazónica" required>
            </label>
            <label>Nombre científico *
                <input name="nombreCientifico" placeholder="Tapirus terrestris" required>
            </label>
            <label>Categoría *
                <select name="categoria" required>
                    <option value="" disabled selected>Seleccione…</option>
                    {{#each categorias}}
                        <option>{{this}}</option>
                    {{/each}}
                </select>
            </label>
            <label>Zona *
                <input name="zona" placeholder="El Caraño" required>
            </label>
            <label>Estado de conservación
                <select name="estadoConservacion">
                    {{#each estadosConservacion}}
                        <option>{{this}}</option>
                    {{/each}}
                </select>
            </label>
            <label>Investigador *
                <input name="investigador" placeholder="Nombre del estudiante o docente" required>
            </label>
            <button type="submit">Registrar</button>
        </form>
    </div>
</section>

<section class="listado contenedor" id="avistamientos">
    <div class="listado-encabezado">
        <div>
            <p class="etiqueta">Registros en MongoDB Atlas</p>
            <h2>Avistamientos registrados ({{avistamientos.length}})</h2>
        </div>
        <a class="boton boton-linea" href="#registrar">+ Nuevo</a>
    </div>

    {{#if avistamientos.length}}
        <table>
            <thead>
                <tr>
                    <th>Especie</th>
                    <th>Categoría</th>
                    <th>Zona</th>
                    <th>Estado</th>
                    <th>Investigador</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#each avistamientos}}
                    <tr>
                        <td class="especie" data-label="Especie"><strong>{{nombreComun}}</strong><em>{{nombreCientifico}}</em></td>
                        <td data-label="Categoría">{{categoria}}</td>
                        <td data-label="Zona">{{zona}}</td>
                        <td data-label="Estado" data-estado="{{estadoConservacion}}">{{estadoConservacion}}</td>
                        <td data-label="Investigador">{{investigador}}</td>
                        <td data-label="Fecha">{{fecha fechaRegistro}}</td>
                        <td class="acciones-fila">
                            <a class="boton boton-linea" href="/editar/{{_id}}">Editar</a>
                            <form action="/api/avistamientos/delete/{{_id}}" method="POST"
                                  onsubmit="return confirm('¿Eliminar este avistamiento?')">
                                <button class="peligro" type="submit">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="vacio">Aún no hay avistamientos registrados. Usa el formulario de registro o Postman.</p>
    {{/if}}
</section>
</div>
