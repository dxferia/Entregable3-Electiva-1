<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bosque: #0b2616; --selva: #14532d; --esmeralda: #1e8f4a; --brillante: #4ade80;
            --texto: #e9f5ec; --suave: #b6d3bf; --linea: rgba(255, 255, 255, .18);
            color-scheme: dark;
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; font-family: "Montserrat", system-ui, sans-serif; color: var(--texto); background: var(--bosque); overflow-x: hidden; line-height: 1.6; }

        /* Paisaje del Caquetá como fondo fijo, con degradado verde para dar legibilidad */
        body::before {
            content: ""; position: fixed; inset: 0; z-index: -1;
            background:
                linear-gradient(100deg, rgba(6, 28, 15, .9) 0%, rgba(8, 38, 20, .66) 45%, rgba(8, 38, 20, .42) 100%),
                url(/img/paisaje-caqueta.jpg) 30% center / cover no-repeat;
        }
        a { color: inherit; }
        img { max-width: 100%; }
        .contenedor { width: min(1180px, 100% - 3rem); margin-inline: auto; }

        /* Navegación */
        .nav { display: flex; align-items: center; gap: 2rem; padding-block: 1.4rem; position: relative; z-index: 10; }
        .marca { display: flex; align-items: center; gap: .7rem; margin-right: auto; font-weight: 800; font-size: 1.3rem; text-decoration: none; }
        .marca svg { width: 40px; height: 40px; }
        .enlaces { display: flex; gap: 2.2rem; }
        .enlaces a { text-decoration: none; font-weight: 600; opacity: .9; }
        .enlaces a:hover, .enlaces a:focus-visible { color: var(--brillante); opacity: 1; }
        .menu-toggle { position: absolute; opacity: 0; pointer-events: none; }
        .hamburguesa { display: none; width: 44px; height: 44px; cursor: pointer; place-items: center; }
        .hamburguesa span, .hamburguesa span::before, .hamburguesa span::after { display: block; width: 24px; height: 2px; background: #fff; position: relative; transition: .25s; }
        .hamburguesa span::before, .hamburguesa span::after { content: ""; position: absolute; }
        .hamburguesa span::before { top: -7px; } .hamburguesa span::after { top: 7px; }
        .menu-toggle:checked + .hamburguesa span { background: transparent; }
        .menu-toggle:checked + .hamburguesa span::before { top: 0; transform: rotate(45deg); }
        .menu-toggle:checked + .hamburguesa span::after { top: 0; transform: rotate(-45deg); }
        .menu-toggle:focus-visible + .hamburguesa { outline: 2px solid var(--brillante); border-radius: 50%; }

        /* Tipografía y elementos comunes */
        .etiqueta { margin: 0 0 .6rem; color: var(--brillante); font-size: .8rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; }
        h1 { margin: 0; font-size: clamp(2.8rem, 7vw, 5.4rem); line-height: 1.02; font-weight: 800; color: #fff; text-shadow: 0 4px 30px rgba(0, 0, 0, .35); }
        .subtitulo { margin: .4rem 0 1.4rem; font-size: clamp(1.05rem, 2.4vw, 1.7rem); font-weight: 300; letter-spacing: .12em; text-transform: uppercase; color: #fff; }
        h2 { margin: 0 0 .4rem; font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.1; font-weight: 800; color: var(--brillante); }
        .descripcion { max-width: 34rem; color: var(--suave); }
        .muted { color: var(--suave); font-size: .9rem; }
        .error { max-width: 34rem; margin: 1.2rem 0 0; padding: .3rem 0 .3rem 1rem; border-left: 3px solid #f87171; color: #fecaca; }
        .acciones { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; align-items: center; }
        .boton, button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: .75rem 1.9rem; border: 0; border-radius: 999px; background: var(--esmeralda); color: #fff; font: inherit; font-weight: 700; font-size: .9rem; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; cursor: pointer; box-shadow: 0 10px 30px rgba(30, 143, 74, .4); transition: .2s; }
        .boton:hover, button:hover { background: #22a556; transform: translateY(-2px); }
        .boton-linea { background: transparent; box-shadow: none; outline: 1.5px solid rgba(255, 255, 255, .55); outline-offset: -1.5px; }
        .boton-linea:hover { background: rgba(255, 255, 255, .1); }
        .peligro { background: transparent; box-shadow: none; color: #fca5a5; padding-inline: .8rem; }
        .peligro:hover { background: rgba(248, 113, 113, .15); }
        .boton:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--brillante); outline-offset: 3px; }

        /* Animales: sin marcos, con bordes difuminados para fundirse con el paisaje */
        .fauna { display: block; object-fit: cover; -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 42%, transparent 96%); mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 42%, transparent 96%); }

        /* Formularios directamente sobre el fondo */
        .campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem 2rem; align-items: end; }
        label { display: flex; flex-direction: column; gap: .35rem; font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--suave); }
        input, select { width: 100%; min-height: 46px; padding: .6rem .3rem; font: inherit; font-size: 1rem; color: #fff; background: rgba(255, 255, 255, .05); border: 0; border-bottom: 1.5px solid rgba(255, 255, 255, .35); border-radius: 4px 4px 0 0; transition: .2s; }
        input::placeholder { color: rgba(233, 245, 236, .45); }
        input:focus, select:focus { outline: none; border-bottom-color: var(--brillante); background: rgba(255, 255, 255, .1); }
        option { background: var(--bosque); color: #fff; }

        .velo { background: linear-gradient(180deg, transparent 0, rgba(6, 28, 15, .82) 14rem, rgba(6, 28, 15, .9) 100%); }
        .pie { background: rgba(6, 28, 15, .92); }
        footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; padding-block: 2.5rem 2rem; border-top: 1px solid var(--linea); font-size: .85rem; color: var(--suave); }
        footer strong { color: #fff; }
        .creditos { font-size: .75rem; opacity: .8; }

        @media (max-width: 820px) {
            body::before { background: linear-gradient(180deg, rgba(6, 28, 15, .55) 0%, rgba(6, 28, 15, .85) 55%, rgba(6, 28, 15, .95) 100%), url(/img/paisaje-caqueta.jpg) 30% center / cover no-repeat; }
            .contenedor { width: min(100% - 2.2rem, 1180px); }
            .hamburguesa { display: grid; }
            .enlaces { display: none; position: absolute; top: 100%; left: -1.1rem; right: -1.1rem; flex-direction: column; gap: 0; padding: .5rem 1.1rem 1rem; background: linear-gradient(180deg, rgba(6, 28, 15, .97), rgba(6, 28, 15, .9)); backdrop-filter: blur(8px); }
            .enlaces a { padding: .9rem 0; border-bottom: 1px solid var(--linea); }
            .menu-toggle:checked ~ .enlaces { display: flex; }
            .campos { grid-template-columns: 1fr; }
            .acciones .boton, .acciones button { flex: 1 1 100%; }
        }
    </style>
</head>
<body>
    <header class="nav contenedor">
        <a class="marca" href="/">
            <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18.5" fill="none" stroke="#4ade80" stroke-width="1.5"/><path d="M20 30V18m0 4c-5 0-8-3-8-8 5 0 8 3 8 8Zm0-3c0-5 3-8 8-8 0 5-3 8-8 8Z" fill="#4ade80" stroke="#4ade80" stroke-width="1.2" stroke-linejoin="round"/></svg>
            BioCaquetá
        </a>
        <input type="checkbox" id="menu" class="menu-toggle" aria-label="Abrir menú de navegación">
        <label for="menu" class="hamburguesa"><span></span></label>
        <nav class="enlaces" aria-label="Principal">
            <a href="/#inicio">Inicio</a>
            <a href="/#registrar">Registrar</a>
            <a href="/#avistamientos">Avistamientos</a>
            <a href="/api/avistamientos" target="_blank">API (JSON)</a>
        </nav>
    </header>

    <main>
        {{{body}}}
    </main>

    <div class="pie">
    <footer class="contenedor">
        <span><strong>BioCaquetá</strong> · Universidad de la Amazonia · Florencia, Caquetá</span>
        <span class="creditos">Fotografías: paisaje, caqueta.travel / todacolombia.com · trogón enmascarado, Camilo Castaño · monos ardilla (chichicos)</span>
        <a href="/api/avistamientos" target="_blank">API REST /api/avistamientos</a>
    </footer>
    </div>
</body>
</html>
